#!/bin/bash
# One-time setup for the Things bar widget: installs the things3-cloud CLI,
# logs you in to Things Cloud, and runs the first sync. Safe to re-run.
set -euo pipefail

say() { printf '\n\033[1m%s\033[0m\n' "$*"; }

HERE="$(cd "$(dirname "$0")" && pwd)"

# 1. The CLI the widget reads and writes through. Bundled — a fork of
#    evanpurkhiser/things3-cloud carrying the Task7 fix — so nothing depends
#    on the AUR package, whose released build silently drops records from
#    newer Things clients. /usr/local/bin wins over any packaged copy.
#    Rebuild whenever the bundled source is newer than the installed binary,
#    not merely when it is missing. `omarchy plugin update` pulls new source
#    but re-runs this script, and guarding on existence alone meant an updated
#    plugin silently kept running the old CLI — security fixes included.
BUILT="$HERE/things3-cloud/target/release/things3"
if [[ ! -x /usr/local/bin/things3 ]] ||
   [[ -n "$(find "$HERE/things3-cloud/src" "$HERE/things3-cloud/Cargo.toml" \
              -newer /usr/local/bin/things3 -print -quit 2>/dev/null)" ]]; then
  command -v cargo >/dev/null 2>&1 || omarchy pkg add rust
  say "Building the bundled things3 CLI (about a minute)…"
  (cd "$HERE/things3-cloud" && cargo build --release)
  if ! cmp -s "$BUILT" /usr/local/bin/things3; then
    say "Installing the bundled things3 CLI to /usr/local/bin (needs sudo)…"
    sudo install -Dm755 "$BUILT" /usr/local/bin/things3
  fi
fi
command -v jq >/dev/null 2>&1 || omarchy pkg add jq

# 2. Things Cloud login — same account as your Mac/iPhone apps. set-auth
#    prompts for your email, then your password (stored locally).
if ! things3 --no-sync --log-level off today >/dev/null 2>&1; then
  say "Log in to Things Cloud:"
  things3 set-auth
fi

# 3. First sync pulls your whole database; give it a minute if it's big.
say "Syncing with Things Cloud…"
things3 --log-level off today >/dev/null

say "Done — Things is in your bar."
cat <<'MSG'

  · Click the pill (or press SUPER+SHIFT+T if you added the keybind)
    to open the panel.
  · Companion terminal app + ALT+SPACE quick-add popup — ships in this
    repo; install it with:
      ~/.config/omarchy/plugins/reysu.things/things-tui/linux/install.sh
MSG
